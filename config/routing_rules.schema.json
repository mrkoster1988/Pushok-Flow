{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pushok Flow route recommendations (data only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_version", "recommended_bypass_packages"],
  "properties": {
    "schema_version": {"const": 1},
    "rules_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "recommended_bypass_packages": {
      "type": "array", "uniqueItems": true, "maxItems": 256,
      "items": {"type": "string", "maxLength": 255,
        "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)+$"}
    }
  }
}
